# ArcRadar environment variables.
# Copy this file to .env.local and fill it in. Never commit .env.local or any real secret.
#
# Local development: start the local Supabase stack (npm run db:start), then run
#   npm run db:env
# to fill in the three Supabase values below automatically.
# Vercel: add the same variables in Project Settings > Environment Variables.

# --- Client-safe (NEXT_PUBLIC_ prefix: included in the browser bundle) ---------
# Supabase API URL. Local: http://127.0.0.1:54321. Hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon (or publishable) key. Public by design; access is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of the app, used for auth redirects. Local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true ONLY for the local stack: shows demo-account buttons on the sign-in page (users created by
# supabase/seed.sql). npm run db:env sets it locally. Leave empty on Vercel.
NEXT_PUBLIC_DEMO_LOGINS=

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ----------------------
# Supabase service-role (or secret) key. Bypasses RLS: server code only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional external intelligence providers (server-only) --------------------
# ArcRadar works without any of these using its built-in demo provider. A provider is enabled only
# when its key is set; live lookups are for analysts and administrators, and private or reserved
# values are never sent out.
# VirusTotal: IP, domain, URL and hash lookups.
VIRUSTOTAL_API_KEY=
# AbuseIPDB: IP lookups.
ABUSEIPDB_API_KEY=
# AlienVault OTX: community threat reports for an indicator.
OTX_API_KEY=
# Shodan InternetDB: open ports and known vulnerabilities of an address. Free, no key: set to true.
SHODAN_INTERNETDB=
# NVD: lets an administrator import a CVE into the vulnerability list.
NVD_API_KEY=

# --- Optional AI providers (server-only) ----------------------------------------
# ArcRadar works with none of these set: the AI features on an alert simply do not appear until an
# administrator both configures a key here and picks that provider as active on the Integrations
# page (Settings > Integrations > AI provider). Only one provider is active at a time.
# Groq: the default, fastest to try (OpenAI-compatible chat completion API).
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# A local Ollama server's address (e.g. http://127.0.0.1:11434). Never exposed to the browser and
# never settable from the admin UI: only whoever deploys ArcRadar controls where this points.
OLLAMA_BASE_URL=

# Detection rules (Wazuh and Splunk): the repository ArcRadar commits approved rules to, as
# owner/name, its branch, and a fine-grained token limited to that one repository with
# "Contents: Read and write" (server-only secret).
GITHUB_TOKEN=
GITHUB_RULES_REPO=
GITHUB_RULES_BRANCH=main

# --- Keys saved from the app (server-only) --------------------------------------
# Lets an administrator paste provider keys (VirusTotal, OpenAI, GitHub, ...) on the API keys page
# instead of editing server settings. They are encrypted with this key before they reach the
# database. 32 random bytes, base64: `openssl rand -base64 32` (or
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`). Keep it safe: lose
# it and the saved keys must be pasted again. Without it, only the variables above are used.
SECRETS_ENCRYPTION_KEY=

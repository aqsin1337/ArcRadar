[arcradar_forward]
param.rule_key = <string>
* The ArcRadar rule key (the number in the saved search's name).

param.name = <string>
* The rule's name; ArcRadar uses it as the alert's title.

param.severity = low | medium | high | critical
* The severity ArcRadar gives the alert.

param.mitre = <string>
* Comma separated MITRE ATT&CK technique ids, for example T1110,T1078.
